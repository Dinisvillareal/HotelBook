          <Link to="/admin/rooms" onClick={() => setMenuOpen(false)} className={navLinkClass('/admin/rooms')} style={getLinkStyle('/admin/rooms')} aria-current={location.pathname === '/admin/rooms' ? 'page' : undefined}>
            <FaBed size={18} /> Manage Rooms
          </Link>
          <Link to="/admin/reservations" onClick={() => setMenuOpen(false)} className={navLinkClass('/admin/reservations')} style={getLinkStyle('/admin/reservations')} aria-current={location.pathname === '/admin/reservations' ? 'page' : undefined}>
            <FaCalendarAlt size={18} /> Reservations
          </Link>
          <Link to="/admin/profile" onClick={() => setMenuOpen(false)} className={navLinkClass('/admin/profile')} style={getLinkStyle('/admin/profile')} aria-current={location.pathname === '/admin/profile' ? 'page' : undefined}>
            <FaUserCircle size={18} /> My Profile
          </Link>

          {/* ADMIN TOOLS */}
          {userRole === 'Admin' && (
            <>
              <div style={{ fontSize: '11px', color: '#adb5bd', fontWeight: 'bold', textTransform: 'uppercase', letterSpacing: '1px', margin: '30px 0 10px 0', paddingLeft: '5px' }}>Administration</div>
              <Link to="/admin/prices" onClick={() => setMenuOpen(false)} className={navLinkClass('/admin/prices')} style={getLinkStyle('/admin/prices')} aria-current={location.pathname === '/admin/prices' ? 'page' : undefined}>
                <FaTags size={18} /> Manage Prices
              </Link>
              <Link to="/admin/staff" onClick={() => setMenuOpen(false)} className={navLinkClass('/admin/staff')} style={getLinkStyle('/admin/staff')} aria-current={location.pathname === '/admin/staff' ? 'page' : undefined}>
                <FaUserPlus size={18} /> Register Staff
              </Link>
            </>
          )}
        </div>

        {/* BOTTOM ACTION AREA */}
        <div style={{ marginTop: 'auto', paddingTop: '20px', borderTop: `1px solid ${COLORS.border}` }}>
          <button
            onClick={handleLogout}
            className="hb-logout"
            style={{
              width: '100%', padding: '14px', backgroundColor: COLORS.roseSoft, color: COLORS.rose,
              border: `1px solid ${COLORS.roseBorder}`, borderRadius: '8px', cursor: 'pointer', fontWeight: 700,
              display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '10px', fontSize: '15px',
              fontFamily: "'Inter', sans-serif", transition: 'all 0.2s ease',
            }}
          >
            <FaSignOutAlt /> Log Out
          </button>
