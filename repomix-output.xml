          <Link to="/admin" onClick={() => setMenuOpen(false)} className={navLinkClass('/admin')} style={getLinkStyle('/admin')} aria-current={location.pathname === '/admin' ? 'page' : undefined}>
            <FaChartPie size={18} /> Overview
          </Link>
          <Link to="/admin/book-room" onClick={() => setMenuOpen(false)} className={navLinkClass('/admin/book-room')} style={getLinkStyle('/admin/book-room')} aria-current={location.pathname === '/admin/book-room' ? 'page' : undefined}>
            <FaEdit size={18} /> Book a Room
