          ) : (
            <>
              <h3 style={{ margin: '0 0 10px 0', color: COLORS.ink, fontSize: '22px', fontFamily: "'Fraunces', serif", fontWeight: 700 }}>
                {profileData.fullName || 'Unnamed User'}
