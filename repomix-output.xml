      {/* SIDEBAR */}
      <nav
        className={`hb-sidebar${menuOpen ? ' hb-open' : ''}`}
        style={{
          width: '260px',
          backgroundColor: COLORS.ivory,
          borderRight: `1px solid ${COLORS.border}`,
          padding: '25px 20px',
          display: 'flex',
          flexDirection: 'column',
          position: 'sticky',
          top: 0,
          height: '100vh',
          boxSizing: 'border-box',
