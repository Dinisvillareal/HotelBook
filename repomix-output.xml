            <FaUserCircle size={58} />
          </div>

          {isProfileLoading ? (
            <>
              <div className="hb-skeleton" style={{ height: '26px', width: '70%', margin: '0 auto 14px auto' }} />
              <div className="hb-skeleton" style={{ height: '24px', width: '45%', margin: '0 auto 30px auto', borderRadius: '20px' }} />
