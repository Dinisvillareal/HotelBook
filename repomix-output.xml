import { Link, useNavigate } from 'react-router-dom';
import { useState } from 'react';
import axios from 'axios';

// ---- Design tokens (boutique-hotel key-tag identity) ----
const COLORS = {
  ink: '#0D2B26',
  emerald: '#1F5D4F',
  emeraldDark: '#123028',
  brass: '#C6A15B',
  brassLight: '#E4CD98',
