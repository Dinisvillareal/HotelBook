// Inline helper for those action buttons
const quickActionBtnStyle = (color, softBg) => ({
  display: 'flex',
  alignItems: 'center',
  gap: '12px',
  width: '100%',
  padding: '15px',
  backgroundColor: softBg,
  color: color,
  border: 'none',
  borderRadius: '8px',
  cursor: 'pointer',
